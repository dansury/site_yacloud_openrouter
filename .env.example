# site_yacloud_openrouter — environment variables.
# Resolution order per key: settings DB row (setup.php) > ENV > config.php default.
# You can configure everything via setup.php instead of ENV.

# ── LLM provider ──
LLM_PROVIDER=openrouter            # openrouter | yandex
LLM_PROVIDER_PRIORITY=openrouter,yandex
LLM_DEFAULT_MODEL=gemini-2.0-flash # short id from AVAILABLE_MODELS (config.php)
# The catalogue is also pulled live from the providers and cached in `settings`;
# setup.php refreshes it on load once the cache is older than this many minutes.
MODEL_CATALOG_TTL_MIN=15
# Backup after the chosen model: auto — a newer version of the SAME model
# (gpt-4.1 -> gpt-5.1), then the list below; manual — the list only.
LLM_FALLBACK_MODE=auto
LLM_FALLBACK_MODELS=              # short ids from AVAILABLE_MODELS, comma-separated

# ── OpenRouter ──
OPENROUTER_API_KEY=
LLM_VISION_MODEL=google/gemini-2.0-flash-001
LLM_FALLBACK_MODEL=openrouter/auto
LLM_OCR_MODELS=google/gemini-2.5-flash,google/gemini-2.0-flash-001

# ── Yandex Cloud (LLM + Vision OCR) ──
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_FALLBACK_MODEL=deepseek-r1
YANDEX_OCR_MODEL=page
YANDEX_OCR_ENABLED=1

# ── Mail (defaults target Yandex SMTP) ──
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=you@yandex.ru
SMTP_PASS=
SMTP_FROM=you@yandex.ru
SMTP_FROM_NAME=site_yacloud_openrouter
ADMIN_EMAIL=admin@example.com
ERROR_EMAIL=

# ── Admin gate for setup.php ──
ADMIN_PASSWORD=

# ── Storage ──
DB_PATH=
LOG_DIR=
